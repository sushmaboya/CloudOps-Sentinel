# ==============================================================================
# CloudOps Sentinel - Comprehensive .gitignore
# ==============================================================================

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
venv*/
.venv/
.venv*/
ENV/
env/

# Pytest & Coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
**/pytest-report.xml
**/pytest-results.xml
**/junit*.xml
**/test-results.xml
htmlcov/
.tox/
.nox/

# --- Node.js & Frontend Artifacts ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.tsbuildinfo
.npm/
.eslintcache
.stylelintcache

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment Secrets & Credentials ---
# Never commit environment secrets, certificates, or credentials
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.pfx
*.p12
id_rsa
id_ecdsa
id_ed25519
secrets/

# Cloud CLI credential stores
.aws/
**/.aws/
**/application_default_credentials.json

# Keep example files tracked
!.env.example
!frontend/.env.example
!backend/.env.example

# --- IDEs & System Files ---
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- DevOps & Infrastructure Artifacts (Future Phases) ---
# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Ansible & CI
*.retry
.jenkins/
