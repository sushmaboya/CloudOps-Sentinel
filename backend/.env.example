# ==============================================================================
# CloudOps Sentinel Backend Environment Configuration Template
# Copy this file to .env before starting the backend service.
# ==============================================================================

# Project Metadata
PROJECT_NAME="CloudOps Sentinel"
VERSION="1.0.0"
DESCRIPTION="Intelligent Cloud Monitoring and Auto-Remediation Platform"
API_V1_PREFIX="/api/v1"

# Runtime Environment (development | staging | production)
ENVIRONMENT="development"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (comma-separated list)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# Phase 1 Simulation Settings (No live AWS resources are accessed)
IS_SIMULATED=true
SIMULATION_REGION="us-east-1"
